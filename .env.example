# Plantilla de variables del frontend.
#
#   cp .env.example .env.local
#
# Las variables NEXT_PUBLIC_ se incrustan en el bundle y son visibles para cualquiera
# que abra la aplicacion: aqui NUNCA van secretos, solo configuracion publica.

# Origen de la API. Debe coincidir con API_PORT del docker compose del backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5025/api

# Visor OHIF de imagenes medicas.
# Importante: el CSP definido en next.config.ts usa este valor para permitir el iframe
# y las conexiones al visor. Si se deja vacio, el navegador bloqueara esa vista.
NEXT_PUBLIC_OHIF_URL=http://localhost:8081
